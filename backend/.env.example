# Port this backend listens on.
PORT=4000

# Where the cpp-sandbox judge's POST /execute endpoint lives.
# If you run the judge with docker-compose.yml alongside this backend,
# use the service name: http://cpp-sandbox-api:3000/execute
JUDGE_URL=http://localhost:3000/execute

# Frontend origin(s) allowed to call this API, comma-separated, or "*".
CORS_ORIGIN=http://localhost:5173

# How many testcases to run in parallel against the judge during /submit.
# Keep this <= the judge's own MAX_CONCURRENT_EXECUTIONS.
SUBMIT_CONCURRENCY=3

JUDGE_TIMEOUT_MS=30000
MAX_SOURCE_BYTES=204800
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
